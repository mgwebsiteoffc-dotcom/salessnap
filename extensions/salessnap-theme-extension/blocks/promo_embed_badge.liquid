{% comment %}
  SaleSnap Promotional Floating Savings Badge
  Theme App Extension - App Embed Block (Target: body)
{% endcomment %}

{% if block.settings.enable != false %}
<div id="salessnap-promo-floating-badge" class="salessnap-promo-floating-badge" style="position: fixed; {% if block.settings.badge_position == 'bottom_left' %}bottom: 24px; left: 24px;{% else %}bottom: 24px; right: 24px;{% endif %} z-index: 2147483630; max-width: 340px; background: {{ block.settings.bg_color | default: '#ffffff' }}; border: 1px solid {{ block.settings.border_color | default: '#d1fae5' }}; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.12); padding: 12px 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.4;">
  <div style="display: flex; align-items: center; gap: 10px;">
    <div style="width: 32px; height: 32px; border-radius: 8px; background: {{ block.settings.accent_color | default: '#10b981' }}; color: #ffffff; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <svg style="width: 18px; height: 18px;" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2s5 2 7 3v5c0 4.5-3.5 7.5-7 8-3.5-.5-7-3.5-7-8V5c2-1 7-3 7-3zm0 2.2C8.3 5 4.9 6.4 4.5 6.7v3.3c0 3.5 2.5 5.8 5.5 6.4 3-.6 5.5-2.9 5.5-6.4V6.7C15.1 6.4 11.7 5 10 4.2zM8.7 11.3l-1.5-1.5a.7.7 0 1 1 1-1l1 1 3-3a.7.7 0 1 1 1 1l-3.5 3.5a.7.7 0 0 1-1 0z" clip-rule="evenodd"/></svg>
    </div>
    <div style="flex: 1;">
      <strong style="font-size: 13px; color: #111827; display: block;">{{ block.settings.title | default: 'Flash Sale Live!' | escape }}</strong>
      <span style="font-size: 11.5px; color: #4b5563;">{{ block.settings.subtitle | default: 'Discounts auto-applied in cart' | escape }}</span>
    </div>
    <button type="button" onclick="document.getElementById('salessnap-promo-floating-badge').style.display='none'" style="border: none; background: transparent; color: #9ca3af; font-size: 16px; cursor: pointer; padding: 0 4px;" aria-label="Close">×</button>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "SaleSnap Promo Badge",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable Floating Promo Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Badge Title",
      "default": "Flash Sale Live!"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Badge Subtitle",
      "default": "Discounts auto-applied in cart"
    },
    {
      "type": "select",
      "id": "badge_position",
      "label": "Badge Position",
      "options": [
        { "value": "bottom_right", "label": "Bottom Right" },
        { "value": "bottom_left", "label": "Bottom Left" }
      ],
      "default": "bottom_right"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#d1fae5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon / Accent Color",
      "default": "#10b981"
    }
  ]
}
{% endschema %}
